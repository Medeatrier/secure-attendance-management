DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL (si DB_ENGINE queda vacío usa SQLite para desarrollo local)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=attendance
DB_USER=attendance
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# Correo SMTP / Microsoft 365
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=asistencia@tu-dominio.es
COORDINATION_EMAILS=

# Microsoft Entra ID (opcional; si no se configura permanece login local)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/auth/entra/callback/
ENTRA_ALLOWED_DOMAIN=

# Teams / Power Automate webhook (opcional)
TEAMS_WEBHOOK_URL=

# Justificantes
MAX_JUSTIFICATION_MB=8
ALLOWED_JUSTIFICATION_EXTENSIONS=pdf,jpg,jpeg,png
